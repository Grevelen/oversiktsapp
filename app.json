{
  "expo": {
    "name": "Overs",
    "slug": "overs",
    "version": "0.1.0",
    "icon": "./assets/images/icon.png",
    "orientation": "portrait",
    "scheme": "overs",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      "expo-web-browser",
      "expo-apple-authentication"
    ],
    "ios": {
      "bundleIdentifier": "com.grevelen.overs",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {},
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b88319ac-8bf0-475c-b841-7d10ab7bbe05"
      }
    },
    "owner": "grevelen",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/b88319ac-8bf0-475c-b841-7d10ab7bbe05"
    }
  }
}
