{
  "expo": {
    "name": "Overs",
    "slug": "overs",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "overs",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker"
    ],
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.grevelen.overs"
    },
    "android": {},
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "b88319ac-8bf0-475c-b841-7d10ab7bbe05"
      }
    },
    "owner": "grevelen"
  }
}
